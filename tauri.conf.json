{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shadow Tentacles",
  "version": "1.0.0",
  "identifier": "com.shadow-tentacles.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "Shadow Tentacles",
        "width": 1180,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost"
    },
    "withGlobalTauri": true,
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "publisher": "WarpCoreDev",
    "copyright": "Copyright (C) 2026 WarpCoreDev",
    "license": "GPL-3.0-or-later",
    "licenseFile": "LICENSE",
    "shortDescription": "A news reader that filters, summarizes and reads the news aloud",
    "longDescription": "Collects articles from RSS feeds and the sitemaps publishers keep, filters them by date and keywords, summarizes and translates them with a language model running either on this machine or at a service you choose, and reads the result aloud.",
    "category": "News",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libasound2t64 | libasound2",
          "libvulkan1",
          "libgomp1"
        ]
      }
    }
  }
}
